#: bigcontrolcenter/usr/bin/guvcview-verify-busy:12
#, sh-format
msgid ""
"A webcam já está sendo utilizada pelo programa: $WEBCAM_BUSY\n"
"\n"
"Abrirei em modo de configuração.\n"
"As alterações feitas podem ser vistas\n"
"na imagem da sua webcam em outros programas."
msgstr ""
"Вэб-камера ўжо выкарыстоўваецца праграмай: $WEBCAM_BUSY\n"
"\n"
"Камера адкрыецца ў рэжыме наладжвання.\n"
"Змены будуць бачныя\n"
"ў выяве з вэб-камеры ў іншых праграмах."

#: bigcontrolcenter/usr/bin/guvcview-verify-busy:16
msgid "Webcam"
msgstr "Вэб-камера"
