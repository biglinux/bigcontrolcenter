#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:527
msgid "Expand device support"
msgstr "Пашырыць падтрымку прылад"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:532
msgid "Detailed information about your computer"
msgstr "Падрабязныя звесткі пра ваш камп'ютар"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:537
msgid "System foundation and video card support"
msgstr "Ядро сістэмы і падтрымка відэакарт"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:542
msgid "Restore program configuration"
msgstr "Аднавіць налады праграмы"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:547
msgid "Search for SSH servers"
msgstr "Шукаць серверы SSH"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:553
msgid "Search for VNC servers"
msgstr "Шукаць серверы VNC"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:559
msgid "Cross-platform buildsystem"
msgstr "Кросплатформавая сістэма зборкі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:564
msgid "Advanced Firewall Settings"
msgstr "Пашыраныя налады міжсеткавага экрана"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:577
msgid "Advanced Audio Manager - Alsamixer"
msgstr "Пашыранае кіраванне гукам — Alsamixer"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:583
msgid "JamesDSP improving music and audio quality"
msgstr "JamesDSP — паляпшэнне якасці музыкі і гуку"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:585
msgid ""
"Enhance your sound with equalizer, bass boost, surround, and other effects."
msgstr ""
"Палепшыце гук з дапамогай эквалайзера, узмацнення басоў, аб'ёмнага гучання і "
"іншых эфектаў."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:591
msgid "Partition or Format"
msgstr "Стварыць раздзелы або адфарматаваць"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:596
msgid "HP Printers"
msgstr "Прынтары HP"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:597
msgid "Check status, ink level, and maintenance."
msgstr "Праверыць стан, узровень чарніла і выканаць абслугоўванне."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:602
msgid "HP Scanners"
msgstr "Сканеры HP"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:603
msgid "Configure and use HP scanning devices"
msgstr "Наладзіць і выкарыстоўваць сканеры HP"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:609
msgid "Configure Kvantum Theme"
msgstr "Наладзіць тэму Kvantum"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:611
msgid ""
"For Kvantum configuration to work, apply the Kvantum theme in 'Application "
"Style'."
msgstr ""
"Каб налады Kvantum дзейнічалі, ужывіце тэму Kvantum у раздзеле «Стыль "
"праграм»."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:617
msgid "USB Device Formatter"
msgstr "Фарматаванне USB-прылад"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:619
msgid "Format a USB device"
msgstr "Адфарматаваць USB-прыладу"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:625
msgid "USB Image Writer"
msgstr "Запіс вобразаў на USB"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:627
msgid "Create a bootable USB device"
msgstr "Стварыць загрузачную USB-прыладу"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:633
msgid "Storage Usage"
msgstr "Выкарыстанне сховішча"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:646
msgid "Sound and microphone"
msgstr "Гук і мікрафон"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:648
msgid "Configure or change audio input and output devices. (Ex: HDMI)"
msgstr "Наладзіць або змяніць прылады ўводу і вываду гуку (напрыклад, HDMI)"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:654
msgid "Printers"
msgstr "Прынтары"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:655
msgid "Install, configure or remove printers."
msgstr "Усталяваць, наладзіць або выдаліць прынтары."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:660
msgid "KDE Control Center"
msgstr "Цэнтр кіравання KDE"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:669
msgid "Configure webcam or capture card"
msgstr "Наладзіць вэб-камеру або плату відэазахопу"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:671
msgid "Adjust settings and control webcams or video capture devices"
msgstr "Змяніць налады і кіраваць вэб-камерамі або прыладамі відэазахопу"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:679
msgid "Configure accessibility options for users with special needs"
msgstr ""
"Наладзіць адмысловыя магчымасці для карыстальнікаў з асаблівымі патрэбамі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:685
msgid "Virtual desktops and activities"
msgstr "Віртуальныя працоўныя сталы і пакоі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:688
msgid ""
"Create more than one virtual work environment by switching between them."
msgstr ""
"Стварыце некалькі віртуальных працоўных асяроддзяў і пераключайцеся паміж "
"імі."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:695
msgid "Manage applications that start automatically on login"
msgstr ""
"Кіраваць праграмамі, якія запускаюцца аўтаматычна пры ўваходзе ў сістэму"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:702
msgid ""
"Enabling search can consume significant memory and processing resources. "
"This may cause the system to slow down, depending on the number of user "
"files."
msgstr ""
"Уключэнне пошуку можа расходаваць значныя рэсурсы памяці і працэсара. Гэта "
"можа запаволіць сістэму ў залежнасці ад колькасці файлаў карыстальніка."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:708
msgid "Connect and manage Bluetooth devices"
msgstr "Падключаць прылады Bluetooth і кіраваць імі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:714
msgid "Manage Thunderbolt devices and security settings"
msgstr "Кіраваць прыладамі Thunderbolt і наладамі бяспекі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:720
msgid "Adjust date, time and timezone."
msgstr "Наладзіць дату, час і часавы пояс."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:726
msgid "Customize the color scheme of your desktop environment"
msgstr "Наладзіць каляровую схему працоўнага асяроддзя"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:733
msgid "Select which applications to use for specific tasks"
msgstr "Выбраць праграмы для пэўных задач"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:739
msgid "Change mouse cursor appearance and themes"
msgstr "Змяніць выгляд і тэмы ўказальніка мышы"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:745
msgid "Configure default paths for documents, downloads and other folders"
msgstr "Наладзіць прадвызначаныя шляхі да дакументаў, спамповак і іншых папак"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:752
msgid "Change the visual appearance of the Plasma desktop"
msgstr "Змяніць выгляд працоўнага стала Plasma"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:759
msgid "Configure which applications open specific file types"
msgstr "Выбраць праграмы для адкрыцця пэўных тыпаў файлаў"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:765
msgid "Manage permissions for Flatpak applications"
msgstr "Кіраваць дазволамі праграм Flatpak"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:781
msgid "Install and configure system fonts and typography settings"
msgstr "Усталяваць і наладзіць сістэмныя шрыфты і параметры тыпаграфікі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:787
msgid "Configure game controllers and joysticks"
msgstr "Наладзіць гульнявыя кантролеры і джойсцікі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:793
msgid "Change the icon theme used throughout the system"
msgstr "Змяніць тэму значкоў для ўсёй сістэмы"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:804
msgid "Configure digital camera integration with your system"
msgstr "Наладзіць інтэграцыю лічбавай камеры з сістэмай"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:811
msgid "Manage system services running in the background"
msgstr "Кіраваць сістэмнымі службамі, якія працуюць у фоне"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:818
msgid "Layout settings, shortcuts and other options."
msgstr "Налады раскладкі, спалучэнні клавіш і іншыя параметры."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:825
msgid "Configure monitors, resolution, and screen arrangement"
msgstr "Наладзіць маніторы, раздзяляльнасць і размяшчэнне экранаў"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:831
msgid "Window Decorations"
msgstr "Аздабленне вокнаў"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:833
msgid "Change the appearance of window title bars and borders"
msgstr "Змяніць выгляд загалоўкаў і рамак вокнаў"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:841
msgid "Configure visual effects and animations for the desktop"
msgstr "Наладзіць візуальныя эфекты і анімацыю працоўнага стала"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:848
msgid "Configure how windows behave and interact"
msgstr "Наладзіць паводзіны і ўзаемадзеянне вокнаў"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:855
msgid "Configure mouse sensitivity, buttons and behavior"
msgstr "Наладзіць адчувальнасць, кнопкі і паводзіны мышы"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:862
msgid ""
"Advanced network configuration (VPN, WiFi, Wired, Static IP, PPPoE, ADSL, "
"wired network, mobile broadband and others)."
msgstr ""
"Пашыраныя налады сеткі (VPN, Wi-Fi, правадное злучэнне, статычны IP, PPPoE, "
"ADSL, правадная сетка, мабільны шырокапалосны доступ і іншыя)."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:872
msgid "QEFI Entry Manager"
