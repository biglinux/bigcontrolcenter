#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:556
msgid "Cross-platform buildsystem"
msgstr "Кросплатформавая сістэма зборкі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:561
msgid "Advanced Firewall Settings"
msgstr "Пашыраныя налады міжсеткавага экрана"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:574
msgid "Advanced Audio Manager - Alsamixer"
msgstr "Пашыранае кіраванне гукам — Alsamixer"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:580
msgid "JamesDSP improving music and audio quality"
msgstr "JamesDSP — паляпшэнне якасці музыкі і гуку"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:582
msgid ""
"Enhance your sound with equalizer, bass boost, surround, and other effects."
msgstr ""
"Палепшыце гук з дапамогай эквалайзера, узмацнення басоў, аб'ёмнага гучання і"
" іншых эфектаў."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:588
