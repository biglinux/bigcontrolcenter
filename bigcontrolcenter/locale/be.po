msgstr "Аднавіць налады праграмы"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:544
msgid "Search for SSH servers"
msgstr "Шукаць серверы SSH"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:550
msgid "Search for VNC servers"
