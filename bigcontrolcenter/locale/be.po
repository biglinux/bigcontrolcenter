#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:593
msgid "HP Printers"
msgstr "Прынтары HP"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:594
msgid "Check status, ink level, and maintenance."
msgstr "Праверыць стан, узровень чарніла і выканаць абслугоўванне."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:599
msgid "HP Scanners"
msgstr "Сканеры HP"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:600
msgid "Configure and use HP scanning devices"
msgstr "Наладзіць і выкарыстоўваць сканеры HP"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:606
msgid "Configure Kvantum Theme"
msgstr "Наладзіць тэму Kvantum"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:608
msgid ""
"For Kvantum configuration to work, apply the Kvantum theme in 'Application "
"Style'."
msgstr ""
"Каб налады Kvantum дзейнічалі, ужывіце тэму Kvantum у раздзеле «Стыль "
"праграм»."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:614
msgid "USB Device Formatter"
msgstr "Фарматаванне USB-прылад"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:616
msgid "Format a USB device"
msgstr "Адфарматаваць USB-прыладу"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:622
msgid "USB Image Writer"
msgstr "Запіс вобразаў на USB"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:624
msgid "Create a bootable USB device"
msgstr "Стварыць загрузачную USB-прыладу"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:630
msgid "Storage Usage"
msgstr "Выкарыстанне сховішча"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:643
msgid "Sound and microphone"
msgstr "Гук і мікрафон"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:645
msgid "Configure or change audio input and output devices. (Ex: HDMI)"
msgstr "Наладзіць або змяніць прылады ўводу і вываду гуку (напрыклад, HDMI)"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:651
msgid "Printers"
msgstr "Прынтары"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:652
msgid "Install, configure or remove printers."
msgstr "Усталяваць, наладзіць або выдаліць прынтары."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:657
msgid "KDE Control Center"
msgstr "Цэнтр кіравання KDE"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:666
msgid "Configure webcam or capture card"
msgstr "Наладзіць вэб-камеру або плату відэазахопу"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:668
msgid "Adjust settings and control webcams or video capture devices"
msgstr "Змяніць налады і кіраваць вэб-камерамі або прыладамі відэазахопу"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:676
msgid "Configure accessibility options for users with special needs"
msgstr ""
"Наладзіць спецыяльныя магчымасці для карыстальнікаў з асаблівымі патрэбамі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:682
msgid "Virtual desktops and activities"
msgstr "Віртуальныя працоўныя сталы і пакоі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:685
msgid ""
"Create more than one virtual work environment by switching between them."
msgstr ""
"Стварыце некалькі віртуальных працоўных асяроддзяў і пераключайцеся паміж "
"імі."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:692
msgid "Manage applications that start automatically on login"
msgstr ""
"Кіраваць праграмамі, якія запускаюцца аўтаматычна пры ўваходзе ў сістэму"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:699
msgid ""
"Enabling search can consume significant memory and processing resources. "
"This may cause the system to slow down, depending on the number of user "
"files."
msgstr ""
"Уключэнне пошуку можа расходаваць значныя рэсурсы памяці і працэсара. Гэта "
"можа запаволіць сістэму ў залежнасці ад колькасці файлаў карыстальніка."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:705
msgid "Connect and manage Bluetooth devices"
msgstr "Падключаць прылады Bluetooth і кіраваць імі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:711
msgid "Manage Thunderbolt devices and security settings"
msgstr "Кіраваць прыладамі Thunderbolt і наладамі бяспекі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:717
msgid "Adjust date, time and timezone."
msgstr "Наладзіць дату, час і часавы пояс."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:723
msgid "Customize the color scheme of your desktop environment"
msgstr "Наладзіць каляровую схему працоўнага асяроддзя"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:730
msgid "Select which applications to use for specific tasks"
msgstr "Выбраць праграмы для пэўных задач"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:736
msgid "Change mouse cursor appearance and themes"
msgstr "Змяніць выгляд і тэмы ўказальніка мышы"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:742
msgid "Configure default paths for documents, downloads and other folders"
msgstr "Наладзіць прадвызначаныя шляхі да дакументаў, спамповак і іншых папак"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:749
msgid "Change the visual appearance of the Plasma desktop"
msgstr "Змяніць выгляд працоўнага стала Plasma"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:756
msgid "Configure which applications open specific file types"
msgstr "Выбраць праграмы для адкрыцця пэўных тыпаў файлаў"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:762
msgid "Manage permissions for Flatpak applications"
msgstr "Кіраваць дазволамі праграм Flatpak"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:778
msgid "Install and configure system fonts and typography settings"
msgstr "Усталяваць і наладзіць сістэмныя шрыфты і параметры тыпаграфікі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:784
msgid "Configure game controllers and joysticks"
msgstr "Наладзіць гульнявыя кантролеры і джойсцікі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:790
msgid "Change the icon theme used throughout the system"
msgstr "Змяніць тэму значкоў для ўсёй сістэмы"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:801
msgid "Configure digital camera integration with your system"
msgstr "Наладзіць інтэграцыю лічбавай камеры з сістэмай"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:808
msgid "Manage system services running in the background"
msgstr "Кіраваць сістэмнымі службамі, якія працуюць у фоне"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:815
msgid "Layout settings, shortcuts and other options."
msgstr "Налады раскладкі, спалучэнні клавіш і іншыя параметры."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:822
msgid "Configure monitors, resolution, and screen arrangement"
msgstr "Наладзіць маніторы, раздзяляльнасць і размяшчэнне экранаў"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:828
msgid "Window Decorations"
msgstr "Афармленне вокнаў"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:830
msgid "Change the appearance of window title bars and borders"
msgstr "Змяніць выгляд загалоўкаў і рамак вокнаў"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:838
msgid "Configure visual effects and animations for the desktop"
msgstr "Наладзіць візуальныя эфекты і анімацыю працоўнага стала"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:845
msgid "Configure how windows behave and interact"
msgstr "Наладзіць паводзіны і ўзаемадзеянне вокнаў"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:852
msgid "Configure mouse sensitivity, buttons and behavior"
msgstr "Наладзіць адчувальнасць, кнопкі і паводзіны мышы"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:859
msgid ""
"Advanced network configuration (VPN, WiFi, Wired, Static IP, PPPoE, ADSL, "
"wired network, mobile broadband and others)."
msgstr ""
"Пашыраныя налады сеткі (VPN, Wi-Fi, правадное злучэнне, статычны IP, PPPoE, "
"ADSL, правадная сетка, мабільны шырокапалосны доступ і іншыя)."

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:869
msgid "QEFI Entry Manager"
msgstr "Кіраванне загрузачнымі запісамі — QEFI"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:871
msgid "Manage and configure boot entries for UEFI systems"
msgstr "Кіраваць загрузачнымі запісамі сістэм UEFI і наладжваць іх"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:878
msgid "Configure system and application notifications"
msgstr "Наладзіць апавяшчэнні сістэмы і праграм"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:883
msgid "Boot Screen"
msgstr "Экран загрузкі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:885
msgid "Change the splash screen shown during system startup"
msgstr "Змяніць застаўку, якая паказваецца падчас запуску сістэмы"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:893
msgid "Configure energy saving and battery settings"
msgstr "Наладзіць энергазберажэнне і параметры батарэі"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/utils/app_finder.py:899
msgid "Configure network proxy settings for internet access"
msgstr "Наладзіць сеткавы проксі для доступу ў інтэрнэт"

