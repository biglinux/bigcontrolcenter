msgstr ""
"Pour partager la connexion Internet de votre smartphone avec un ordinateur "
"Linux à l'aide d'un câble USB, suivez ces étapes :"

#: bigcontrolcenter/usr/share/biglinux/bigcontrolcenter/ui/device_connection_dialog.py:153
msgid "Close"
msgstr "Fermer"

